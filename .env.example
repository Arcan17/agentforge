# App
APP_NAME=AgentForge
LOG_LEVEL=INFO
ENVIRONMENT=development          # development | production

# Database
DATABASE_URL=postgresql+asyncpg://agentforge:agentforge@localhost:5432/agentforge

# LLM — primary provider
LLM_PROVIDER=anthropic           # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                  # always required for openai provider; optional for anthropic

# Agent tuning
MAX_REVISIONS=3                  # max analyst/critic retry cycles
CRITIC_APPROVAL_THRESHOLD=0.75   # score >= this passes to writer
MAX_RESEARCH_RESULTS=5           # max web search results per subtask
REQUEST_TIMEOUT_SECONDS=30       # per-tool HTTP timeout

# Auth — leave empty to disable, set a value to require X-API-Key
API_KEY=

# Human-in-the-loop — set true to require human approval before Writer step
HUMAN_IN_LOOP=false

# Celery + Redis (task queue for LangGraph worker process)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Tavily (optional alternative to DuckDuckGo)
TAVILY_API_KEY=                  # leave empty to use DuckDuckGo (free)
